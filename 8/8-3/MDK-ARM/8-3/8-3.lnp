"8-3\stm32f1xx_hal.o"
"8-3\stm32f1xx_hal_rcc.o"
"8-3\stm32f1xx_hal_rcc_ex.o"
"8-3\stm32f1xx_hal_gpio.o"
"8-3\stm32f1xx_hal_dma.o"
